# Contractor Safety Tools
# Static Hostinger deployment rules.

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host: HTTPS apex domain.
# Hostinger handles HTTP -> HTTPS after SSL is enabled.
RewriteCond %{HTTP_HOST} ^www\.safetysitepro\.com$ [NC]
RewriteRule ^ https://safetysitepro.com%{REQUEST_URI} [R=301,L]
</IfModule>
